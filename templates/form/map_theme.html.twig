{# Checkbox + label as one flex item (Symfony renders them as siblings by default). #}
{%- block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="map-choices">
        {%- for child in form %}
            <label class="map-choice">
                {{- form_widget(child) -}}
                <span>{{ child.vars.label }}</span>
            </label>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded -%}
