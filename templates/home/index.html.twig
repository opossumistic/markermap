{% extends 'base.html.twig' %}

{% block title %}Tauschmap — Tauschboxen Hamburg{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('vendor/maplibre-gl/maplibre-gl.css') }}">
{% endblock %}

{% block body %}
    <div
        class="map-shell"
        data-controller="map-shell"
        data-map-shell-style-url-value="{{ mapStyleUrl }}"
        data-map-shell-locations-url-value="{{ path('api_locations_geojson') }}"
        data-map-shell-reverse-url-value="{{ path('api_reverse_geocode') }}"
        data-map-shell-geocode-url-value="{{ path('api_geocode') }}"
        data-map-shell-report-url-template-value="/melden/__ID__"
        data-map-shell-report-token-value="{{ csrf_token('report_gone') }}"
        data-map-shell-open-add-value="{{ openAdd ? 'true' : 'false' }}"
        data-map-shell-focus-id-value="{{ focusId|default(0) }}"
    >
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div
                    class="map-flash map-flash--{{ label }}"
                    role="status"
                    aria-live="assertive"
                    data-controller="flash"
                    data-flash-delay-value="5500"
                    title="Klicken zum Schließen"
                >
                    <strong class="map-flash__title">{% if label == 'success' %}Gesendet{% elseif label == 'error' %}Fehler{% else %}Hinweis{% endif %}</strong>
                    <p class="map-flash__body">{{ message }}</p>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="map-chrome">
            <div class="map-toolbar">
                <a class="map-brand" href="{{ path('home') }}" aria-label="Tauschmap Startseite">Tauschmap</a>
                <form class="map-search" data-action="submit->map-shell#searchAddress" role="search">
                    <input
                        type="search"
                        class="map-search__input"
                        placeholder="Adresse suchen…"
                        autocomplete="off"
                        enterkeyhint="search"
                        data-map-shell-target="searchQuery"
                        aria-label="Adresse in Hamburg suchen"
                    >
                    <button
                        type="button"
                        class="map-btn map-btn--icon map-search__locate"
                        data-action="map-shell#goToCurrentLocation"
                        data-map-shell-target="locateButton"
                        aria-label="Zum aktuellen Standort"
                        title="Zum aktuellen Standort"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                            <path fill="currentColor" d="M12 2a1 1 0 0 1 1 1v1.07A8.001 8.001 0 0 1 19.93 11H21a1 1 0 1 1 0 2h-1.07A8.001 8.001 0 0 1 13 19.93V21a1 1 0 1 1-2 0v-1.07A8.001 8.001 0 0 1 4.07 13H3a1 1 0 1 1 0-2h1.07A8.001 8.001 0 0 1 11 4.07V3a1 1 0 0 1 1-1m0 4a6 6 0 1 0 0 12a6 6 0 0 0 0-12m0 3a3 3 0 1 1 0 6a3 3 0 0 1 0-6"/>
                        </svg>
                    </button>
                    {# Submit via Enter / mobile search key; keep for a11y & form semantics. #}
                    <button type="submit" class="visually-hidden">Suchen</button>
                    <ul class="map-search__results" data-map-shell-target="searchResults" hidden></ul>
                </form>
                <button
                    type="button"
                    class="map-btn map-btn--icon map-toolbar__add"
                    data-action="map-shell#startAdd"
                    aria-label="Box eintragen"
                    title="Box eintragen — oder auf die Karte tippen"
                >
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
                        <path fill="currentColor" d="M12 4a1 1 0 0 1 1 1v6h6a1 1 0 1 1 0 2h-6v6a1 1 0 1 1-2 0v-6H5a1 1 0 1 1 0-2h6V5a1 1 0 0 1 1-1"/>
                    </svg>
                    <span class="map-toolbar__add-label">Box eintragen</span>
                </button>
            </div>
        </div>

        <nav class="map-legal" aria-label="Rechtliches">
            <a href="{{ path('legal_impressum') }}">Impressum</a>
            <a href="{{ path('legal_datenschutz') }}">Datenschutz</a>
        </nav>

        <div
            class="map-canvas"
            data-map-shell-target="canvas"
            role="region"
            aria-label="Karte der Tauschboxen in Hamburg"
        ></div>

        <aside class="map-sheet" data-map-shell-target="sheet" hidden>
            <div class="map-sheet__header">
                <h2 class="map-sheet__title" data-map-shell-target="sheetTitle">Details</h2>
                <button type="button" class="map-sheet__close" data-action="map-shell#closeSheet" aria-label="Schließen">×</button>
            </div>

            <div class="map-sheet__body" data-map-shell-target="detailPanel" hidden></div>

            <div class="map-sheet__body map-sheet__add" data-map-shell-target="addPanel" hidden>
                <p class="picker-status" data-map-shell-target="pickerStatus" role="status">Klicke auf die Karte oder suche eine Adresse.</p>

                {{ form_start(form, { action: path('location_submit'), attr: { novalidate: 'novalidate', class: 'map-sheet__form', 'data-turbo': 'false' } }) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.title) }}
                    {{ form_row(form.street) }}
                    {{ form_row(form.postalCode) }}
                    {{ form_row(form.categories) }}
                    {{ form_row(form.description) }}
                    {{ form_row(form.image) }}

                    {% if form.lat.vars.errors|length or form.lng.vars.errors|length %}
                        <p class="picker-status is-error">Bitte einen Standort innerhalb Hamburgs auf der Karte setzen.</p>
                    {% endif %}

                    <div class="coord-field">{{ form_widget(form.lat) }}</div>
                    <div class="coord-field">{{ form_widget(form.lng) }}</div>

                    {{ form_row(form.email) }}
                    {{ form_row(form.website) }}
                    <button type="submit" class="map-btn map-btn--block">Vorschlag absenden</button>
                {{ form_end(form) }}
            </div>

            <div class="map-sheet__body map-sheet__add" data-map-shell-target="correctPanel" hidden>
                <p class="picker-status">Infos vorausgefüllt — Standort bleibt. Andere Position = neuer Eintrag. Sichtbar nach Freigabe.</p>

                {{ form_start(correctionForm, { action: path('location_correct'), attr: { novalidate: 'novalidate', class: 'map-sheet__form', 'data-turbo': 'false' } }) }}
                    {{ form_errors(correctionForm) }}
                    {{ form_row(correctionForm.locationId) }}
                    {{ form_row(correctionForm.title) }}
                    {{ form_row(correctionForm.description) }}
                    {{ form_row(correctionForm.categories) }}
                    {{ form_row(correctionForm.image) }}
                    {{ form_row(correctionForm.reason) }}
                    {{ form_row(correctionForm.email) }}
                    {{ form_row(correctionForm.website) }}
                    <button type="submit" class="map-btn map-btn--block">Änderung absenden</button>
                {{ form_end(correctionForm) }}

                <div class="map-detail__actions">
                    <button
                        type="button"
                        class="map-btn map-btn--block map-btn--muted"
                        data-map-shell-target="reportGoneButton"
                        data-action="map-shell#reportGone"
                    >Nicht mehr vorhanden melden</button>
                </div>
            </div>
        </aside>
    </div>
{% endblock %}
