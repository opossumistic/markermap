{% extends 'base.html.twig' %}

{% block title %}Admin Locations{% endblock %}

{% block body %}
    <main class="admin admin--wide">
        <p class="admin__nav">
            <a href="{{ path('admin_inbox') }}">← Inbox</a>
            · <a href="{{ path('home') }}">Karte</a>
            ·
            <form action="{{ path('admin_logout') }}" method="post" class="admin__logout" data-turbo="false">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                <button type="submit">Logout</button>
            </form>
        </p>
        <h1>Locations auf der Karte</h1>
        <p>Soft-Remove blendet den Pin aus (Status <code>removed</code>). Offene Submissions dazu werden geschlossen.</p>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <p class="admin__flash admin__flash--{{ label }}">{{ message }}</p>
            {% endfor %}
        {% endfor %}

        {% if locations is empty %}
            <p>Keine sichtbaren Locations.</p>
        {% else %}
            <ul class="admin-list">
                {% for location in locations %}
                    <li class="admin-card">
                        <header class="admin-card__head">
                            <span class="admin-card__id">#{{ location.id }}</span>
                            <span class="admin-card__status">{{ location.status.value }}</span>
                        </header>

                        <div class="admin-card__body">
                            <p class="admin-card__title">{{ location.displayLabel }}</p>
                            <p class="admin-card__text">
                                {{ location.street ?? '—' }}
                                {% if location.district %}<br>{{ location.district }}{% endif %}
                            </p>
                            <p class="admin-card__coords">{{ location.lat|number_format(5) }}, {{ location.lng|number_format(5) }}</p>
                        </div>

                        <div class="admin-card__actions">
                            <form method="post" action="{{ path('admin_location_remove', {id: location.id}) }}" onsubmit="return confirm('Location #{{ location.id }} wirklich von der Karte entfernen?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('remove' ~ location.id) }}">
                                <input type="hidden" name="redirect" value="admin_locations">
                                <button type="submit" class="admin-card__btn admin-card__btn--reject">Entfernen</button>
                            </form>
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
