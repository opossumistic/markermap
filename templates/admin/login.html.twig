{% extends 'base.html.twig' %}

{% block title %}Plattform-Admin Login{% endblock %}

{% block body %}
    <main class="admin">
        <p class="admin__role">Plattform · alle Maps</p>
        <p><a href="{{ path('platform_home') }}">← Zur Übersicht</a></p>
        <h1>Plattform-Admin</h1>
        <p>Zugang für den Betreiber (alle Maps). Map-Owner loggen sich unter „Map verwalten“ auf der jeweiligen Karte ein.</p>

        {% if error %}
            <p class="admin__error" role="alert">Anmeldung fehlgeschlagen. Bitte Zugangsdaten prüfen.</p>
        {% endif %}

        <form class="admin__form" action="{{ path('admin_login') }}" method="post" data-turbo="false">
            <label class="admin__field">
                <span>Benutzername</span>
                <input type="text" name="_username" value="{{ last_username }}" required autocomplete="username" autocapitalize="none" spellcheck="false">
            </label>
            <label class="admin__field">
                <span>Passwort</span>
                <input type="password" name="_password" required autocomplete="current-password">
            </label>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="admin__submit">Anmelden</button>
        </form>
    </main>
{% endblock %}
